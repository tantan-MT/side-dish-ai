<div data-controller="ingredients">

  <h1>食材を選んで副菜を提案</h1>

  <%= link_to "レシピを提案する",
      recipes_show_path,
      class: "btn-primary disabled",
      data: {
        ingredients_target: "submit"
      } %>

  <% @categories.each do |category| %>

    <section class="ingredient-section">

      <h2><%= category.name %></h2>

      <div class="ingredient-grid">

        <% category.ingredients.each do |ingredient| %>

          <button
            class="ingredient-card"
            data-action="click->ingredients#toggle">

            <div class="ingredient-circle">

            </div>

            <span><%= ingredient.name %></span>

          </button>

        <% end %>

      </div>

    </section>

  <% end %>

</div>
