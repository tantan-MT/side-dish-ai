<div data-controller="ingredients">

  <h1>食材を選んで副菜を提案</h1>

  <%= form_with url: recipes_path,
                method: :post,
                local: true do %>

    <% @categories.each do |category| %>

      <section class="ingredient-section">

        <h2><%= category.name %></h2>

        <div class="ingredient-grid">

          <% category.ingredients.each do |ingredient| %>

            <button
              type="button"
              class="ingredient-card"
              data-action="click->ingredients#toggle">

              <div class="ingredient-circle">

                <% image_file =
                     if ingredient.image_name.present? &&
                        Rails.root.join("app/assets/images/ingredients", ingredient.image_name).exist?
                       ingredient.image_name
                     else
                       "no_image.png"
                     end %>

                <%= image_tag "ingredients/#{image_file}",
                              alt: ingredient.name,
                              class: "ingredient-image" %>

              </div>

              <span><%= ingredient.name %></span>

            </button>

            <%= hidden_field_tag "ingredient_ids[]",
                                 ingredient.id,
                                 disabled: true,
                                 data: {
                                   ingredients_target: "input"
                                 } %>

          <% end %>

        </div>

      </section>

    <% end %>

    <%= submit_tag "🍳 レシピを提案する",
                   class: "btn-primary disabled",
                   data: {
                     ingredients_target: "submit"
                   },
                   disabled: true %>

  <% end %>

</div>
