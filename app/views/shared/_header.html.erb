<header class="header">
  <nav class="navbar">
    <%= link_to "🍳 Side Dish AI", root_path, class: "logo" %>

    <div class="nav-links">
      <% if user_signed_in? %>
        <%= link_to "レシピ提案", root_path, class: "nav-link" %>
        <%= link_to "保存レシピ", favorites_path, class: "nav-link" %>
        <%= link_to "マイページ", user_path, class: "nav-link" %>
        <%= link_to "ログアウト", destroy_user_session_path,
              data: { turbo_method: :delete },
              class: "nav-link logout" %>
      <% else %>
        <%= link_to "ログイン",
              new_user_session_path,
              class: "nav-link" %>

        <%= link_to "新規登録",
              new_user_registration_path,
              class: "btn-primary" %>
      <% end %>
    </div>
  </nav>
</header>
