<div class="recipe-header">

  <p class="recipe-label">
    🍽 AIがおすすめする副菜
  </p>

  <h1><%= @recipe.title %></h1>

  <p class="recipe-description">
    <%= @recipe.description %>
  </p>

</div>

<div class="recipe-section">

  <h2>🥕 材料</h2>

  <ul class="recipe-list">
    <% @ingredients.each do |ingredient| %>
      <li>✓ <%= ingredient %></li>
    <% end %>
  </ul>

</div>

<div class="recipe-section">

  <h2>🍳 作り方</h2>

  <ol class="recipe-list">
    <% @steps.each do |step| %>
      <li><%= step %></li>
    <% end %>
  </ol>

</div>

<div class="recipe-buttons">

  <%= button_to "⭐ 保存する",
      favorites_path,
      method: :post,
      params: {
        title: @recipe.title,
        instructions: @steps.join("\n")
      },
      class: "btn-primary" %>

  <%= link_to "🔄 もう一度提案する",
      root_path,
      class: "btn-secondary" %>

</div>
