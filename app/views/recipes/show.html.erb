<h1><%= @recipe[:title] %></h1>

<p><%= @recipe[:description] %></p>

<h2>材料</h2>
<ul>
  <% @recipe[:ingredients].each do |ingredient| %>
    <li><%= ingredient %></li>
  <% end %>
</ul>

<h2>作り方</h2>
<ol>
  <% @recipe[:steps].each do |step| %>
    <li><%= step %></li>
  <% end %>
</ol>

<%= link_to "もう一度提案する", recipes_show_path, class: "btn btn-secondary" %>

<%= button_to "保存する",
    favorites_path,
    method: :post,
    params: {
      title: @recipe[:title],
      instructions: @recipe[:steps].join("\n")
    },
    class: "btn btn-primary" %>

<%= link_to "トップに戻る", root_path %>
